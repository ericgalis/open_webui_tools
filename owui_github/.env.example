# Copy to .env (chmod 600). Only the github-tool container reads this file.

# Fine-grained PAT: All repositories; Contents RW, Pull requests RW, Metadata R. NOT Workflows.
GITHUB_TOKEN=

# openssl rand -hex 32   — also paste into the Open WebUI tool's SIDECAR_API_KEY valve
SIDECAR_API_KEY=

# The only branch the tool will ever write to (created from the default branch if missing)
WRITE_BRANCH=dev

# Comma-separated path prefixes the tool refuses to write (Actions workflows run with repo secrets)
BLOCKED_PATH_PREFIXES=.github/workflows/

# Optional: comma-separated Open WebUI user ids allowed to use the tool (empty = any user the tool is shared with)
ALLOWED_OWUI_USER_IDS=

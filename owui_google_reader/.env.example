# Copy to .env (chmod 600). Only the google-reader container reads this file.

# OAuth client from Google Cloud Console (type: Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# openssl rand -hex 32   — also paste into the Open WebUI tool's SIDECAR_API_KEY valve
SIDECAR_API_KEY=

# How a browser reaches the link pages (published port below)
PUBLIC_BASE_URL=http://192.168.4.73:8766

# Leave unset for Desktop-app loopback + paste-back (works with LAN IPs).
# With a real HTTPS hostname + Web-application client: <PUBLIC_BASE_URL>/oauth/callback
#OAUTH_REDIRECT_URI=

# Compose port publishing
LINK_BIND_ADDR=192.168.4.73
LINK_PORT=8766
